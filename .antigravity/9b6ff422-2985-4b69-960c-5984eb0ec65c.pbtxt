            }
            lines {
              text: "  const [bids, setBids] = useState(["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    { price: 88418.0, size: 2.45, pct: 85 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    { price: 88415.5, size: 4.12, pct: 70 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    { price: 88412.0, size: 1.88, pct: 55 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    { price: 88410.0, size: 6.94, pct: 90 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  ]);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const [asks, setAsks] = useState(["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    { price: 88422.5, size: 1.95, pct: 60 },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    { price: 88425.0, size: 3.44, pct: 75 },"

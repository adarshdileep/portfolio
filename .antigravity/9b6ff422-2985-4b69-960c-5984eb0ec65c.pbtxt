  code_action {
    action_spec {
      create_file {
        instruction: "import React, { useState, useEffect } from \'react\';\nimport { Navbar } from \'./components/Navbar\';\nimport { Hero } from \'./components/Hero\';\nimport { MobileSimulator } from \'./components/MobileSimulator\';\nimport { ProjectShowcase } from \'./components/ProjectShowcase\';\nimport { ArchitectureInspector } from \'./components/ArchitectureInspector\';\nimport { BenchmarksSection } from \'./components/BenchmarksSection\';\nimport { TelemetryLog } from \'./components/TelemetryLog\';\nimport { TerminalConsole } from \'./components/TerminalConsole\';\nimport { ProjectDossierModal } from \'./components/ProjectDossierModal\';\nimport { AuditModal } from \'./components/AuditModal\';\nimport { Footer } from \'./components/Footer\';\nimport { Project } from \'./types\';\nimport { PROJECTS } from \'./data/portfolioData\';\n\nexport default function App() {\n  const [isAuditModalOpen, setIsAuditModalOpen] = useState(false);\n  const [isTerminalOpen, setIsTerminalOpen] = useState(false);\n  const [selectedProject, setSelectedProject] = useState<Project | null>(null);\n\n  // Keyboard shortcut for cockpit terminal (`~` or backtick)\n  useEffect(() => {\n    const handleKeyDown = (e: KeyboardEvent) => {\n      if (e.key === \'`\' && ![\'INPUT\', \'TEXTAREA\'].includes((e.target as HTMLElement).tagName)) {\n        e.preventDefault();\n        setIsTerminalOpen((prev) => !prev);\n      }\n    };\n    window.addEventListener(\'keydown\', handleKeyDown);\n    return () => window.removeEventListener(\'keydown\', handleKeyDown);\n  }, []);\n\n  const scrollToSection = (id: string) => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  const handleSelectProjectById = (id: string) => {\n    const found = PROJECTS.find((p) => p.id === id);\n    if (found) {\n      setSelectedProject(found);\n    }\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#080B12] text-[#F5F7FA] font-[\'Inter\'] selection:bg-[#9FE870] selection:text-[#080B12]\">\n      {/* 3-Zone Top Navigation Bar */}\n      <Navbar\n        onRequestAudit={() => setIsAuditModalOpen(true)}\n        onOpenTerminal={() => setIsTerminalOpen(true)}\n      />\n\n      {/* Main Content Sections */}\n      <main>\n        {/* Section 1: Hero Cockpit */}\n        <Hero\n          onExploreMobileStage={() => scrollToSection(\'mobile-stage\')}\n          onExploreCodeInspector={() => scrollToSection(\'code-inspector\')}\n          onRequestAudit={() => setIsAuditModalOpen(true)}\n        />\n\n        {/* Section 2: Flagship Mobile Architecture Simulator Stage */}\n        <MobileSimulator />\n\n        {/* Section 3: Editorial Project Showcases & Architecture Case Studies */}\n        <ProjectShowcase onSelectProject={(p) => setSelectedProject(p)} />\n\n        {/* Section 4: Systems & C++ JSI Code Inspector */}\n        <ArchitectureInspector />\n\n        {/* Section 5: Hardware & Runtime Benchmarks Stress Tester */}\n        <BenchmarksSection />\n\n        {/* Section 6: Commit & Telemetry Activity Log */}\n        <TelemetryLog />\n      </main>\n\n      {/* Footer */}\n      <Footer\n        onRequestAudit={() => setIsAuditModalOpen(true)}\n        onOpenTerminal={() => setIsTerminalOpen(true)}\n      />\n\n      {/* Interactive Cockpit Terminal Console Dialog */}\n      <TerminalConsole\n        isOpen={isTerminalOpen}\n        onClose={() => setIsTerminalOpen(false)}\n        onRequestAudit={() => {\n          setIsTerminalOpen(false);\n          setIsAuditModalOpen(true);\n        }}\n        onSelectProject={(id) => {\n          handleSelectProjectById(id);\n        }}\n      />\n\n      {/* Architecture Deep Dive Dossier Modal */}\n      <ProjectDossierModal\n        project={selectedProject}\n        onClose={() => setSelectedProject(null)}\n        onRequestAudit={() => {\n          setSelectedProject(null);\n          setIsAuditModalOpen(true);\n        }}\n      />\n\n      {/* Architecture Audit Request Modal */}\n      <AuditModal\n        isOpen={isAuditModalOpen}\n        onClose={() => setIsAuditModalOpen(false)}\n      />\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/App.tsx"
        }
        overwrite: true
      }
    }

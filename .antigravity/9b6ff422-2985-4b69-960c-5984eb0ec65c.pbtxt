            lines {
              text: "      setPulsePhase((prev) => (prev + 1) % 100);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      setHeartRate((prev) => 70 + Math.floor(Math.sin(Date.now() / 2000) * 5));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    }, isJsi ? 50 : 200);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    return () => clearInterval(interval);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {

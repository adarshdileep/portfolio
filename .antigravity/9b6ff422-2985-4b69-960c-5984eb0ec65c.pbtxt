9,232,112,0.4)] transition-all cursor-pointer uppercase\"\n            >\n              Request Audit\n            </button>\n          </div>\n        </div>\n\n        <div className=\"mt-8 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs text-[#A1AAB8]\">\n          <div>\n            &copy; {new Date().getFullYear()} Adarsh Dileep. Designed with Obsidian Kinetic System.\n          </div>\n          <div className=\"flex items-center gap-4 text-[11px]\">\n            <a\n              href=\"mailto:adarshodileep@gmail.com\"\n              className=\"hover:text-[#9FE870] transition-colors\"\n            >\n              adarshodileep@gmail.com\n            </a>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span className=\"text-[#65D6C5]\">C++20 / JSI / Fabric / Skia</span>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n};\n"

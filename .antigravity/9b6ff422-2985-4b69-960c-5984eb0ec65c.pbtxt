      thinking_signature: "\022\375\t\n\372\t\001i\024}\023\r\036\033co=>\263\t\317\245\275:\255t\t\r~\205\f\277\210^a\r\017\t\362\357R\315o\207\267\332\246\264o0>(wV\305\310\336\216v\224\277f\356O\233\314\250[\304\351_Z\2231\265\3404\2744~,:\211<\210\377\244\257\325L;\212n.l\270\b\313z\314\341Cm\255\310\337\351\276\016\275\023yo\262f\327\274\325\350\362\201\245a{\335\022(\234\023A<n\235\301\206\323t\272doyZ\243\267\026\a\261X9,\305\344\252\330\256y\334K\035\002\253G)\231\035\275x\036\032\320\357<4\002<0\312\235~S@\004\3123`\211r*\246\245o\035t[<W\221s\362~\307b\366N\263\353\244\213q\023\372N^\236T+M\236\"\213&\274\327(\236\037K\3118\225T\002\227\233\fz\305\202\177\355A<\355T\260\335\361\233\273\347\332!v\337\353O\300\207\310\177\217\314\025(\v\211\001>\343\206J\276\1778^\274\366\242&\326\264R\373\251\314\267\244\357\215\367p\312#`\276\210\327\334\270#\301\221\243t\205`\361\365\323\251H\245 \254cvH\3510(\b\000\371\027\017\3106+\270\242lPs\275 x\205=\006N\n\316^\325\200\274\324Df\367\206\255\035d\005zp[\251f\216\340H\310v\262\203\377r\0166{\250\234\364\200\027\221\374u\026\266*AU\326\244m}Ol\270\204\303l1\217v\\\273\225\361i\251\267\363\371|}\374\\)\a\261\323-\232 G\246\201\177\341\304>\251\341\232\201:\374]\231\320\037\315\034\222\232]\244\302\354M\r&\226\324\240\317\321\273G\304m\355\003\000\253\213~\253\315\030\n\337\253\206\251\031\n\331\322\256Y(#o\253NEGF\261\244f\033\247p\301\264[\231\227\366X\220\342\366\261\371\330F\333\252>\225\347\303\342\'d\246\214\344\003\243\302\313-H\213n\310\341\307\300X\332/\3055\274\352\366\336\266/\307\'&2!\327L\210\335\242g\221\a\226\001g9\026\222\002jh}g;\247\354\225\323\372\212p\265\337\177\251\245\017\317\326ta\366\'%Q\215\255\262m\302w\030\201\243\33685\307a\254kQ\022\2536\"\363\3667K\224\036\315\335\031\232\224\177\245s\025\253\213\222\330\346?\266/\023GR\b\340\255\027\253\367\3668!8\324\334\343N\347-\a6`\214\034vQ=\265\244\020\226\343Q\2750\254U\271_\305\000\375!\212#\264\352A\271\321\324\251c0\357\035\304I\205\005s\317#\365
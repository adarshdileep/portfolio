  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Terminal, Cpu } from \'lucide-react\';\n\ninterface NavbarProps {\n  onRequestAudit: () => void;\n  onOpenTerminal: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ onRequestAudit, onOpenTerminal }) => {\n  return (\n    <header className=\"sticky top-0 z-50 w-full border-b border-[#273244] bg-[#080B12]/85 backdrop-blur-md\">\n      <div className=\"mx-auto flex h-16 max-w-[1440px] items-center justify-between gap-8 px-6 lg:px-8\">\n        {/* Zone 1: Brand Wordmark (Single text element) */}\n        <a\n          href=\"#\"\n          className=\"flex items-center gap-2.5 font-[\'Space_Grotesk\'] text-base font-bold tracking-tight text-[#F5F7FA] transition-colors hover:text-[#9FE870] whitespace-nowrap shrink-0\"\n        >\n          <div className=\"flex h-7 w-7 items-center justify-center rounded-[4px] border border-[#273244] bg-[#111827] text-[#9FE870]\">\n            <Cpu className=\"h-4 w-4\" />\n          </div>\n          <span>ADARSH DILEEP</span>\n          <span className=\"font-mono text-xs font-normal text-[#65D6C5]\">/ KINETIC</span>\n        </a>\n\n        {/* Zone 2: 4-5 Clean single-line text nav links */}\n        <nav className=\"hidden md:flex items-center gap-7 font-[\'Inter\'] text-xs font-medium uppercase tracking-wider text-[#A1AAB8]\">\n          <a\n            href=\"#architecture\"\n            className=\"whitespace-nowrap shrink-0 transition-colors hover:text-[#F5F7FA]\"\n          >\n            Architecture\n          </a>\n          <a\n            href=\"#mobile-stage\"\n            className=\"whitespace-nowrap shrink-0 transition-colors hover:text-[#F5F7FA]\"\n          >\n            Mobile Stage\n          </a>\n          <a\n            href=\"#code-inspector\"\n            className=\"whitespace-nowrap shrink-0 transition-colors hover:text-[#F5F7FA]\"\n          >\n            Systems Inspector\n          </a>\n          <a\n            href=\"#telemetry\"\n            className=\"whitespace-nowrap shrink-0 transition-colors hover:text-[#F5F7FA]\"\n          >\n            Telemetry Log\n          </a>\n          <a\n            href=\"#benchmarks\"\n            className=\"whitespace-nowrap shrink-0 transition-colors hover:text-[#F5F7FA]\"\n          >\n            Benchmarks\n          </a>\n        </nav>\n\n        {/* Zone 3: 1 Primary Action + Quick Terminal Launcher */}\n        <div className=\"flex items-center gap-3 shrink-0\">\n          <button\n            onClick={onOpenTerminal}\n            aria-label=\"Open Interactive Cockpit Terminal\"\n            className=\"hidden sm:flex h-9 items-center gap-2 rounded-[4px] border border-[#273244] bg-[#111827] px-3 font-mono text-xs text-[#A1AAB8] transition-all hover:border-[#65D6C5] hover:text-[#65D6C5]\"\n          >\n            <Terminal className=\"h-3.5 w-3.5\" />\n            <span>&gt; terminal</span>\n          </button>\n\n          <button\n            onClick={onRequestAudit}\n            className=\"h-9 rounded-[4px] bg-[#9FE870] px-4 font-mono text-xs font-semibold uppercase text-[#080B12] transition-all hover:shadow-[0_0_20px_rgba(159,232,112,0.4)] active:scale-95 whitespace-nowrap shrink-0 cursor-pointer\"\n          >\n            Request Audit\n          </button>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }

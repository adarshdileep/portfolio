  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { ArrowUpRight, Play, Terminal, Zap, ShieldCheck, Activity } from \'lucide-react\';\n\ninterface HeroProps {\n  onExploreMobileStage: () => void;\n  onExploreCodeInspector: () => void;\n  onRequestAudit: () => void;\n}\n\nexport const Hero: React.FC<HeroProps> = ({\n  onExploreMobileStage,\n  onExploreCodeInspector,\n  onRequestAudit,\n}) => {\n  return (\n    <section className=\"relative overflow-hidden border-b border-[#273244] bg-[#080B12] bg-cartesian-grid pt-12 pb-16 lg:pt-20 lg:pb-24\">\n      {/* Subtle radial ambient spotlight */}\n      <div\n        className=\"pointer-events-none absolute -top-40 left-1/2 h-[500px] w-[800px] -translate-x-1/2 rounded-full opacity-20 blur-[130px]\"\n        style={{\n          background: \'radial-gradient(circle, #65D6C5 0%, #9FE870 50%, transparent 80%)\',\n        }}\n      />\n\n      <div className=\"mx-auto max-w-[1440px] px-6 lg:px-8\">\n        {/* Top Mechanical Meta Readout */}\n        <div className=\"mb-6 flex flex-wrap items-center gap-4 text-xs font-mono\">\n          <div className=\"flex items-center gap-2 rounded-[4px] border border-[#273244] bg-[#111827] px-3 py-1 text-[#F5F7FA]\">\n            <span className=\"relative flex h-2 w-2\">\n              <span className=\"absolute inline-flex h-full w-full animate-ping rounded-full bg-[#9FE870] opacity-75\"></span>\n              <span className=\"relative inline-flex h-2 w-2 rounded-full bg-[#9FE870]\"></span>\n            </span>\n            <span className=\"font-semibold text-[#9FE870]\">PRODUCTION STATUS:</span>\n            <span className=\"text-[#A1AAB8]\">Available for Architecture Audits</span>\n          </div>\n\n          <div className=\"hidden sm:flex items-center gap-2 text-[#A1AAB8]\">\n            <span>STK: React Native 0.78</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>JSI HostObjects</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Fabric C++</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Skia Metal/Vulkan</span>\n          </div>\n        </div>\n\n        {/* Hero Split Grid */}\n        <div className=\"grid grid-cols-1 gap-12 lg:grid-cols-12 lg:items-center\">\n          {/* Left Column: Architectural Typography & CTAs (7 cols) */}\n          <div className=\"lg:col-span-7\">\n            <h1 className=\"font-[\'Space_Grotesk\'] text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#F5F7FA] leading-[1.08] text-balance\">\n              HIGH-FREQUENCY <br className=\"hidden sm:inline\" />\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-[#9FE870] via-[#65D6C5] to-[#F5F7FA]\">\n                MOBILE ARCHITECTURE\n              </span>{\' \'}\n              <br className=\"hidden sm:inline\" />\n              & CREATIVE SYSTEMS.\n            </h1>\n\n            <p className=\"mt-6 max-w-2xl font-[\'Inter\'] text-base sm:text-lg leading-relaxed text-[#A1AAB8]\">\n              Senior Mobile Architect and C++ Systems Engineer. Engineering zero-latency\n              React Native runtimes, bespoke TurboModules, JSI memory conduits, and 120 FPS\n              Skia GPU shaders for high-throughput fintech, biosensor health, and creative platforms.\n            </p>\n\n            {/* Interactive Kinetic CTAs */}\n            <div className=\"mt-8 flex flex-wrap items-center gap-4\">\n              <button\n                onClick={onExploreMobileStage}\n                className=\"group flex h-11 items-center gap-2.5 rounded-[4px] bg-[#9FE870] px-6 font-mono text-xs font-semibold uppercase text-[#080B12] transition-all hover:shadow-[0_0_25px_rgba(159,232,112,0.45)] active:scale-95 cursor-pointer\"\n              >\n                <Play className=\"h-3.5 w-3.5 fill-[#080B12]\" />\n                <span>Launch Mobile Stage</span>\n                <ArrowUpRight className=\"h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5\" />\n              </button>\n\n              <button\n                onClick={onExploreCodeInspector}\n                className=\"group flex h-11 items-center gap-2.5 rounded-[4px] border border-[#273244] bg-[#111827]/80 px-5 font-mono text-xs font-medium text-[#F5F7FA] transition-all hover:border-[#65D6C5] hover:text-[#65D6C5] hover:bg-[#1A2234] active:scale-95 cursor-pointer\"\n              >\n                <Terminal className=\"h-3.5 w-3.5\" />\n                <span>Inspect C++ / JSI Core</span>\n              </button>\n\n              <button\n                onClick={onRequestAudit}\n                className=\"font-mono text-xs text-[#A1AAB8] underline underline-offset-4 hover:text-[#9FE870] transition-colors py-2 px-1 cursor-pointer\"\n              >\n                Schedule Technical Review &rarr;\n              </button>\n            </div>\n          </div>\n\n          {/* Right Column: Architectural Cockpit Snapshot (5 cols) */}\n          <div className=\"lg:col-span-5\">\n            <div className=\"relative rounded-[8px] border border-[#273244] bg-[#111827]/90 p-5 shadow-[0_16px_32px_-8px_rgba(0,0,0,0.6)] backdrop-blur-md\">\n              {/* Terminal Title Bar */}\n              <div className=\"flex items-center justify-between border-b border-[#273244] pb-3 text-xs font-mono\">\n                <div className=\"flex items-center gap-2 text-[#A1AAB8]\">\n                  <span className=\"h-2 w-2 rounded-full bg-[#FF5555]\"></span>\n                  <span className=\"h-2 w-2 rounded-full bg-[#FFB86C]\"></span>\n                  <span className=\"h-2 w-2 rounded-full bg-[#9FE870]\"></span>\n                  <span className=\"ml-2 text-[#F5F7FA]\">hermes_runtime_dispatch.cc</span>\n                </div>\n                <span className=\"text-[#65D6C5]\">0.08ms JSI</span>\n              </div>\n\n              {/* Live Metric Simulation Matrix */}\n              <div className=\"mt-4 space-y-3 font-mono text-xs\">\n                <div className=\"flex items-center justify-between rounded-[4px] border border-[#273244]/60 bg-[#080B12]/80 p-2.5\">\n                  <div className=\"flex items-center gap-2 text-[#A1AAB8]\">\n                    <Zap className=\"h-3.5 w-3.5 text-[#9FE870]\" />\n                    <span>JS &lt;-&gt; Native Bridge</span>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-bold text-[#9FE870]\">DIRECT MEMCPY</span>\n                    <span className=\"ml-2 text-[10px] text-[#A1AAB8]\">(Zero Copy)</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between rounded-[4px] border border-[#273244]/60 bg-[#080B12]/80 p-2.5\">\n                  <div className=\"flex items-center gap-2 text-[#A1AAB8]\">\n                    <Activity className=\"h-3.5 w-3.5 text-[#65D6C5]\" />\n                    <span>Rendering Cadence</span>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-bold text-[#65D6C5]\">120 FPS</span>\n                    <span className=\"ml-2 text-[10px] text-[#A1AAB8]\">8.3ms Budget</span>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between rounded-[4px] border border-[#273244]/60 bg-[#080B12]/80 p-2.5\">\n                  <div className=\"flex items-center gap-2 text-[#A1AAB8]\">\n                    <ShieldCheck className=\"h-3.5 w-3.5 text-[#FFB86C]\" />\n                    <span>Hermes Nursery Alloc</span>\n                  </div>\n                  <div className=\"text-right\">\n                    <span className=\"font-bold text-[#FFB86C]\">&lt; 4MB</span>\n                    <span className=\"ml-2 text-[10px] text-[#A1AAB8]\">0 GC Stalls</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Code Snippet Highlight */}\n              <div className=\"mt-4 rounded-[4px] bg-[#080B12] p-3 font-mono text-[11px] leading-relaxed text-[#A1AAB8]\">\n                <div className=\"text-[#65D6C5]\">// Direct host pointer resolution</div>\n                <div>\n                  <span className=\"text-[#FF5555]\">const auto</span>* ptr = buffer-&gt;getDirectRing();\n                </div>\n                <div>\n                  <span className=\"text-[#9FE870]\">jsi::ArrayBuffer</span> buf = rt.createBuffer(ptr);\n                </div>\n                <div className=\"text-[#A1AAB8] opacity-70\">// Yielding 0ms bridge queuing delay</div>\n              </div>\n\n              {/* Bottom Telemetry Stamp */}\n              <div className=\"mt-3 flex items-center justify-between text-[10px] font-mono text-[#A1AAB8]\">\n                <span>ARCH: ARM64-v8a / Apple Silicon</span>\n                <span className=\"text-[#9FE870]\">SYS: OPTIMAL</span>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Adjacency Proof Metrics Strip (Full-width below split) */}\n        <div className=\"mt-14 grid grid-cols-2 gap-4 border-t border-[#273244] pt-8 sm:grid-cols-4 lg:gap-6\">\n          <div className=\"rounded-[4px] border border-[#273244] bg-[#111827]/50 p-4\">\n            <div className=\"font-mono text-2xl sm:text-3xl font-bold text-[#9FE870] tabular-nums\">\n              120 FPS\n            </div>\n            <div className=\"mt-1 font-[\'Space_Grotesk\'] text-sm font-semibold text-[#F5F7FA]\">\n              Skia & Fabric Pipeline\n            </div>\n            <div className=\"mt-1 text-xs text-[#A1AAB8]\">\n              Hardware accelerated Metal/Vulkan GPU drawing\n            </div>\n          </div>\n\n          <div className=\"rounded-[4px] border border-[#273244] bg-[#111827]/50 p-4\">\n            <div className=\"font-mono text-2xl sm:text-3xl font-bold text-[#65D6C5] tabular-nums\">\n              &lt; 2.4ms\n            </div>\n            <div className=\"mt-1 font-[\'Space_Grotesk\'] text-sm font-semibold text-[#F5F7FA]\">\n              Zero-Copy JSI Dispatch\n            </div>\n            <div className=\"mt-1 text-xs text-[#A1AAB8]\">\n              Direct memory pointer invocation in Hermes\n            </div>\n          </div>\n\n          <div className=\"rounded-[4px] border border-[#273244] bg-[#111827]/50 p-4\">\n            <div className=\"font-mono text-2xl sm:text-3xl font-bold text-[#FFB86C] tabular-nums\">\n              0.00%\n            </div>\n            <div className=\"mt-1 font-[\'Space_Grotesk\'] text-sm font-semibold text-[#F5F7FA]\">\n              Bridge Serialization Drops\n            </div>\n            <div className=\"mt-1 text-xs text-[#A1AAB8]\">\n              Zero frame drops under 4,500 ticks/sec load\n            </div>\n          </div>\n\n          <div className=\"rounded-[4px] border border-[#273244] bg-[#111827]/50 p-4\">\n            <div className=\"font-mono text-2xl sm:text-3xl font-bold text-[#F5F7FA] tabular-nums\">\n              99.98%\n            </div>\n            <div className=\"mt-1 font-[\'Space_Grotesk\'] text-sm font-semibold text-[#F5F7FA]\">\n              Crash-Free Sessions\n            </div>\n            <div className=\"mt-1 text-xs text-[#A1AAB8]\">\n              Production stability across 14M+ active installs\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Hero.tsx"
        }
        overwrite: true
      }
    }
